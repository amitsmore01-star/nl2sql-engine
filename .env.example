# .env.example
# V0 - Initial implementation
# V1 - Replaced API_KEY with CLIENT_API_KEY and FOUNDRY_API_KEY (Story 2.4)
#
# Copy this file to .env and fill in your values.
# Never commit .env to GitHub.

# Service
ENV=dev

# API Authentication
# CLIENT_API_KEY protects POST /v1/query
# FOUNDRY_API_KEY protects POST /v1/tools/*
# Both are required in prod. In dev, missing keys mean those routes always return 401.
CLIENT_API_KEY=your-client-api-key-here
FOUNDRY_API_KEY=your-foundry-api-key-here

PORT=8000

# LLM — change this to switch provider (mock | openai | azure_openai | anthropic)
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=your-key-here

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment
AZURE_OPENAI_API_VERSION=2024-02-01

# Anthropic
ANTHROPIC_API_KEY=your-key-here

# Logging
LOG_DIR=logs
LOG_ARCHIVE_DIR=logs/archive
